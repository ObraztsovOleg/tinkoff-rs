# Encrypted copies of the stand's database in an S3 bucket (Cloud.ru Object Storage
# or any S3-compatible storage). Copy to docker/local/backup/s3.env and fill in;
# the file stays on this computer. Without it copies stay only in the stand volume.
#
# Cloud.ru: Object Storage -> bucket; IAM -> service account -> access key for
# Object Storage. The key ID has the form <tenant_id>:<key_id>.
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Copies are encrypted with this passphrase before upload. Keep it outside the
# computer as well: without it the copies cannot be restored.
BACKUP_PASSPHRASE=
# Prefix inside the bucket and how many days of copies to keep there.
S3_PREFIX=tinkoff-rs/
OFFSITE_KEEP_DAYS=30
