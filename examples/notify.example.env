# Telegram notifications of the stand: trades, risk blocks, futures rolls, AI model
# failures, stopped processes, low disk, failed backups and a daily summary.
# Copy to docker/local/notify/telegram.env and fill in; the file stays on this computer.
#
# 1. In Telegram open @BotFather, send /newbot and copy the token.
# 2. Write any message to the new bot, then open
#    https://api.telegram.org/bot<token>/getUpdates and copy "chat":{"id":...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Hour of the daily summary, Moscow time.
NOTIFY_DAILY_HOUR=19
# Every trade (yes) or only problems and the summary (no).
NOTIFY_TRADES=yes
